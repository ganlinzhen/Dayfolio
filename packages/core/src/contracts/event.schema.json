{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "externalId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "timeKind": {
      "enum": [
        "timed",
        "all_day",
        "tbd"
      ]
    },
    "startAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "endAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "startDate": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "endDateExclusive": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "sourceTimezone": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 80
    },
    "status": {
      "enum": [
        "scheduled",
        "postponed",
        "cancelled",
        "finished"
      ]
    },
    "sourceUrl": {
      "type": "string",
      "pattern": "^https://",
      "maxLength": 2048
    },
    "payload": {
      "type": "object"
    }
  },
  "required": [
    "externalId",
    "title",
    "timeKind",
    "startAt",
    "endAt",
    "startDate",
    "endDateExclusive",
    "status",
    "sourceUrl",
    "payload"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "timeKind": {
            "const": "timed"
          }
        }
      },
      "then": {
        "properties": {
          "startAt": {
            "type": "string"
          },
          "startDate": {
            "type": "null"
          },
          "endDateExclusive": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "timeKind": {
            "const": "all_day"
          }
        }
      },
      "then": {
        "properties": {
          "startAt": {
            "type": "null"
          },
          "endAt": {
            "type": "null"
          },
          "startDate": {
            "type": "string"
          },
          "endDateExclusive": {
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "timeKind": {
            "const": "tbd"
          }
        }
      },
      "then": {
        "properties": {
          "startAt": {
            "type": "null"
          },
          "endAt": {
            "type": "null"
          },
          "startDate": {
            "type": "null"
          },
          "endDateExclusive": {
            "type": "null"
          }
        }
      }
    }
  ],
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:dayfolio:p0:v1:event"
}
